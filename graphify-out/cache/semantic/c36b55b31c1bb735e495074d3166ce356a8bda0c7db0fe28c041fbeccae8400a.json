{"nodes": [{"id": "agents_cadence_backend", "label": "Cadence Backend Agent Manual", "file_type": "document", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_domain_first_architecture", "label": "Domain-First Architecture", "file_type": "concept", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each domain folder owns its routes, schemas, and utilities; platform layer holds only cross-cutting infrastructure so a route contract change never leaks domain logic into shared code."}, {"id": "agents_platform_neutral_api", "label": "Platform-Neutral Universal API", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No cookies, server actions, or framework-coupled session state; every endpoint must be consumable identically by web, mobile, and desktop so breaking a contract does not break multiple clients at once."}, {"id": "agents_withrls_pattern", "label": "withRls Per-Request RLS Pattern", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RLS context must be set before user-scoped queries; withRls guarantees config and queries run on the same connection in one transaction, mandatory because Workers are isolates with Hyperdrive pooling."}, {"id": "agents_getdbclient_per_request", "label": "Per-Request DB Client (getDbClient)", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never cache a DB client globally on Cloudflare Workers isolates; create via getDbClient(c.env) per request and let Hyperdrive handle pooling."}, {"id": "agents_idempotency_key", "label": "Idempotency-Key Header Pattern", "file_type": "concept", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Write endpoints dedupe via the Idempotency-Key header backed by the mutationDedup table; no-ops when key is undefined."}, {"id": "agents_apptype_rpc_boundary", "label": "AppType Hono RPC Boundary", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AppType is exported from src/index.ts as a critical integration boundary so frontend consumes typed Hono RPC contracts instead of brittle filesystem imports."}, {"id": "agents_jwt_bearer_auth", "label": "Bearer JWT Auth via Neon Auth JWKS", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth is always Authorization: Bearer JWT verified with jose against JWKS; userId comes from JWT sub only, never trusted from the client."}, {"id": "agents_overdue_cron", "label": "Overdue Check Cron Job", "file_type": "concept", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily 06:00 UTC cron runs handleOverdueCheck to increment task_metrics.delay_count and pruneStaleMutations to clean the mutationDedup table."}, {"id": "agents_debug_seed_system", "label": "Debug Seed Scenario System", "file_type": "concept", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debug domain provides fixture builders and a Scenario registry; routes disabled by default unless ENABLE_DEBUG_ROUTES=true in non-production."}, {"id": "agents_drizzle_schema_source_of_truth", "label": "Drizzle Schema Single Source of Truth", "file_type": "rationale", "source_file": "apps/backend/AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "src/db/schema.ts is the canonical source for all tables and enums; migrations are generated and checked, never pushed with destructive commands."}], "edges": [{"source": "agents_cadence_backend", "target": "agents_domain_first_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_platform_neutral_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_withrls_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_getdbclient_per_request", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_idempotency_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_apptype_rpc_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_cadence_backend", "target": "agents_jwt_bearer_auth", "rel