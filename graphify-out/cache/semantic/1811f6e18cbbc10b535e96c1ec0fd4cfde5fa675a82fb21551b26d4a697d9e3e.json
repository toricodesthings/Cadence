{"nodes": [{"id": "desktop_release_pipeline_desktop_release_pipeline", "label": "Cadence Desktop Release Pipeline", "file_type": "document", "source_file": "apps/desktop/docs/desktop-release-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "desktop_release_pipeline_git_tag_release", "label": "Git-Tag-Triggered Native CI Release", "file_type": "rationale", "source_file": "apps/desktop/docs/desktop-release-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Releases trigger on v* tags and build on native macOS/Windows/Linux runners; CI builds are the artifacts of record because no single machine can cross-build every platform reliably."}, {"id": "desktop_release_pipeline_signing_notarization", "label": "Signing and Notarization Requirements", "file_type": "rationale", "source_file": "apps/desktop/docs/desktop-release-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "macOS DMG must be signed and notarized, Windows NSIS signed, and updater artifacts signed with the Tauri private key kept only in CI secrets, or distribution quality and trust degrade."}, {"id": "desktop_release_pipeline_sync_version", "label": "sync-version Source-of-Truth Script", "file_type": "concept", "source_file": "apps/desktop/docs/desktop-release-pipeline.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sync-version propagates the tag version into package.json, tauri.conf.json, and Cargo.toml so version metadata stays consistent across the desktop build."}], "edges": [{"source": "desktop_release_pipeline_desktop_release_pipeline", "target": "desktop_release_pipeline_git_tag_release", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/