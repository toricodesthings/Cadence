{"nodes": [{"id": "03_15_2026_release_readiness_audit_plan_19", "label": "Release Readiness Audit Plan 19", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-15-2026_release-readiness-audit-plan-19.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Production-readiness audit covering auth surface rebuild, passive timetable block model, toast/holiday/location fixes, web-platform-verify CI, and an OWASP Top 10 security review."}, {"id": "03_15_2026_release_readiness_audit_plan_19_owasp_review", "label": "OWASP Top 10 Web Security Review", "file_type": "concept", "source_file": "apps/frontend/docs/Initial Release/03-15-2026_release-readiness-audit-plan-19.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reviews access control (debug route disablement, RLS), crypto (jose JWT, secret scanning), injection (Zod + Drizzle), insecure design (passive recurring blocks), and dependency vulnerabilities by OWASP category."}, {"id": "03_15_2026_release_readiness_audit_plan_19_shared_location_service", "label": "Shared Location Service", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-15-2026_release-readiness-audit-plan-19.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holiday overlay and weather independently call geolocation, prompting twice; a shared location store should own permission state and resolved coordinates so both surfaces consume one source."}, {"id": "03_15_2026_release_readiness_audit_plan_19_settings_flush", "label": "Settings Persistence Flush-on-Unmount", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-15-2026_release-readiness-audit-plan-19.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ration