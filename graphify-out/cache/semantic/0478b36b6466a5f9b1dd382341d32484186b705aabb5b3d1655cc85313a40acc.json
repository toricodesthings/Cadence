{"nodes": [{"id": "03_07_2026_ui_refinement_plan_11", "label": "UI Refinement Plan 11", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design-quality assessment driving responsive shell modes, 44px targets, document titles, contrast floor enforcement, font-role reassignment, and auth surface re-skin."}, {"id": "03_07_2026_ui_refinement_plan_11_responsive_shell_modes", "label": "Four Responsive Shell Modes", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The authenticated shell is desktop-first and keeps rail + side panels mounted on phone; it should define wide/laptop/tablet/phone modes so navigation and detail panels adapt instead of squeezing."}, {"id": "03_07_2026_ui_refinement_plan_11_contrast_floor", "label": "Manifesto Contrast Floor as System Rule", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app.css contrast floor must be treated as a blocking rule, removing low-opacity muted text from core information so essential labels and dates meet WCAG AA."}, {"id": "03_07_2026_ui_refinement_plan_11_auth_reskin", "label": "Auth Surface Native Re-Skin", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Neon Auth module reads as a foreign double-card with generic copy and undersized controls; auth must become a first-class Cadence room with one surface language, 44px controls, and route titles."}], "edges": [{"source": "03_07_2026_ui_refinement_plan_11", "target": "03_07_2026_ui_refinement_plan_11_responsive_shell_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "weight": 1.0}, {"source": "03_07_2026_ui_refinement_plan_11", "target": "03_07_2026_ui_refinement_plan_11_contrast_floor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "weight": 1.0}, {"source": "03_07_2026_ui_refinement_plan_11", "target": "03_07_2026_ui_refinement_plan_11_auth_reskin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "weight": 1.0}, {"source": "03_07_2026_ui_refinement_plan_11_contrast_floor", "target": "agents_design_tokens_appcss", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "weight": 1.0}, {"source": "03_07_2026_ui_refinement_plan_11_auth_reskin", "target": "03_15_2026_release_readiness_audit_plan_19", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/frontend/docs/Initial Release/03-07-2026_ui-refinement-plan-11.md", "source_location": null, "weight": 1.0}], "hyperedges": []}