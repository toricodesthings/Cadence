{"nodes": [{"id": "03_10_2026_timetable_designplan6", "label": "Timetable Recurring Blocks Design Plan 6", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_10_2026_timetable_designplan6_recurring_series", "label": "Recurring Timed Task Series", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timetable support is implemented as recurring timed task series rendered as virtual schedule instances, reusing the tasks domain rather than adding a new table or route so the app stays simple for users who never use it."}, {"id": "03_10_2026_timetable_designplan6_backend_expansion", "label": "Backend Recurrence Expansion", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The backend expands recurring masters into virtual instances only for schedule-scoped queries (scheduledDate/scheduledRange) with deterministic synthetic IDs, mirroring habit expansion so recurrence logic does not fork across clients."}, {"id": "03_10_2026_timetable_designplan6_series_first", "label": "Series-First Editing & Drag Safety", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "V1 edits the whole series; dragging a recurring block opens the series editor instead of silently creating an exception, trading a little speed for protection against accidental global edits (neurodivergent-friendly)."}, {"id": "03_10_2026_timetable_designplan6_interaction_mode", "label": "Passive Timetable Interaction Mode", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recurring timetable blocks are passive schedule anchors that suppress complete/archive affordances and read as anchors, not guilt-inducing recurring checklist items."}], "edges": [{"source": "03_10_2026_timetable_designplan6", "target": "03_10_2026_timetable_designplan6_recurring_series", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "weight": 1.0}, {"source": "03_10_2026_timetable_designplan6", "target": "03_10_2026_timetable_designplan6_backend_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "weight": 1.0}, {"source": "03_10_2026_timetable_designplan6", "target": "03_10_2026_timetable_designplan6_series_first", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "weight": 1.0}, {"source": "03_10_2026_timetable_designplan6", "target": "03_10_2026_timetable_designplan6_interaction_mode", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "weight": 1.0}, {"source": "03_10_2026_timetable_designplan6_recurring_series", "target": "02_27_2026_implementation_plan_4_multi_view_calendar", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "recurrence_virtual_instance_pattern", "label": "Recurrence Expansion to Virtual Schedule Instances", "nodes": ["03_01_2026_habit_implementation_plan_6_virtual_habit_logs", "03_10_2026_timetable_designplan6_backend_expansion", "03_10_2026_timetable_designplan6_recurring_series", "03_10_2026_timetable_designplan6_interaction_mode"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/frontend/docs/Initial Release/03-10-2026-timetable-DesignPlan6.md"}]}