{"nodes": [{"id": "tauri_porting_plan_tauri_porting_plan", "label": "Cadence Desktop Porting Plan", "file_type": "document", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tauri_porting_plan_platform_adapter_layer", "label": "Frontend Platform Adapter Layer", "file_type": "rationale", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small runtime abstraction (runtime.ts/web.ts/desktop.ts) isolates notifications, OAuth callbacks, external URLs, update checks, and platformFetch so web updates flow into desktop with minimal friction and no scattered isTauri checks."}, {"id": "tauri_porting_plan_native_http_transport", "label": "Tauri Native HTTP Transport (platformFetch)", "file_type": "rationale", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packaged Tauri origin is not in backend CORS allowlist, so desktop routes all API calls through @tauri-apps/plugin-http behind a centralized platformFetch adapter instead of changing backend CORS."}, {"id": "tauri_porting_plan_external_browser_oauth", "label": "External-Browser OAuth + Deep Link Return", "file_type": "rationale", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embedded webviews are fragile for OAuth and some providers block them, so social login opens the system browser and returns via the cadence:// custom scheme deep link."}, {"id": "tauri_porting_plan_tauri_updater", "label": "Tauri Signed Updater (GitHub Releases)", "file_type": "concept", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use the Tauri updater plugin from the start with GitHub Releases latest.json; shipping without a signed update path creates immediate operational debt."}, {"id": "tauri_porting_plan_service_worker_guard", "label": "Desktop Service-Worker/PWA Guard", "file_type": "rationale", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Service workers cache stale assets and fight the desktop updater, so manifest and SW registration are disabled in desktop builds where the app bundle is the update unit."}, {"id": "tauri_porting_plan_capability_least_privilege", "label": "Tauri Capability Least-Privilege Model", "file_type": "rationale", "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capability files in src-tauri/capabilities are auto-enabled unless explicitly enumerated, so Cadence explicitly enumerates and scopes HTTP/opener/notification/updater/deep-link permissions to prevent accidental permission growth."}], "edges": [{"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_platform_adapter_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_native_http_transport", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_external_browser_oauth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_tauri_updater", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_service_worker_guard", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_tauri_porting_plan", "target": "tauri_porting_plan_capability_least_privilege", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_native_http_transport", "target": "agents_platform_neutral_api", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}, {"source": "tauri_porting_plan_native_http_transport", "target": "tauri_porting_plan_platform_adapter_layer", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "apps/desktop/docs/tauri-porting-plan.md", "source_location": null, "weight": 1.0}], "hyperedges": []}