{"nodes": [{"id": "03_09_2026_frontend_polish_plan_13", "label": "Frontend Polish Plan 13 (Route Roles)", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_09_2026_frontend_polish_plan_13_holding_route", "label": "Holding Route (projectId = null)", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inbox is renamed Holding and becomes the capture/landing route defined by projectId = null (not missing dates), owning greeting and quick capture while keeping the /inbox path and Inbox aliases."}, {"id": "03_09_2026_frontend_polish_plan_13_today_viewer", "label": "Today as Overdue-plus-Today Viewer", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Today becomes a simplified aggregate viewer (overdue first, then today) modeled after Upcoming, with no capture controls, to fix the reversed Today/Inbox product roles."}, {"id": "03_09_2026_frontend_polish_plan_13_date_semantics_helper", "label": "Deterministic Deadline/Duration Semantics Helper", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single scheduling-summary helper classifies tasks as deadline (due on a day), duration (date range), or timed block via a precedence matrix so components stop deriving date copy ad hoc and legacy mixed shapes render deterministically."}, {"id": "03_09_2026_frontend_polish_plan_13_panel_mode", "label": "Full-Height Panel-Mode Layout", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedule/habits detail panels should shrink the canvas in layout flow at full viewport height instead of overlay sheets, with one surface owning vertical scroll so panel scroll never moves the calendar horizontally."}, {"id": "03_09_2026_frontend_polish_plan_13_habit_cache_segregation", "label": "Habit Active/Archived Cache Segregation", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Habit caches must segregate active vs archived views and serialize per-habit-per-day mutations so archived habits do not leak, new habits survive reconciliation, and out-of-order responses cannot revert the latest optimistic state."}], "edges": [{"source": "03_09_2026_frontend_polish_plan_13", "target": "03_09_2026_frontend_polish_plan_13_holding_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "weight": 1.0}, {"source": "03_09_2026_frontend_polish_plan_13", "target": "03_09_2026_frontend_polish_plan_13_today_viewer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-09-2026_frontend-polish-plan-13.md", "source_location": null, "weight": 1.0}, {"source": "03_09_2026_frontend_polish_plan_13", "target": "03_09_2026_frontend_polish_plan_13_date_semantics_helper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/