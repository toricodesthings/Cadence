{"nodes": [{"id": "03_02_2026_implementation_plan_7", "label": "Implementation Plan #7 (Feature Evolution)", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "03_02_2026_implementation_plan_7_waiting_state", "label": "Waiting Task State", "file_type": "concept", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WAITING is a first-class task state hidden from Today by default with waitingOn/waitingReminder fields, reducing cognitive load by keeping non-actionable work out of the present."}, {"id": "03_02_2026_implementation_plan_7_not_before", "label": "Not-Before Date Filtering", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tasks with not_before in the future stay invisible in Today until that date arrives, preventing future tasks from polluting the present as a core sanctuary principle."}, {"id": "03_02_2026_implementation_plan_7_kanban_sections", "label": "Kanban as View Mode over Sections", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kanban is a view-mode toggle (not a standalone route) whose columns are user-defined sections, not task states; a standalone /board route fragmented the UX so it was removed."}, {"id": "03_02_2026_implementation_plan_7_view_mode_dual_persistence", "label": "View Mode Dual Persistence", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useViewMode persists to localStorage for instant first-render read and to the backend settings JSONB for cross-device sync."}, {"id": "03_02_2026_implementation_plan_7_silent_task_metrics", "label": "Silent Internal Task Metrics", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "task_metrics (reschedule_count, delay_count, created_to_done) are tracked invisibly for future AI insights; invisible tracking means zero cognitive load now."}, {"id": "03_02_2026_implementation_plan_7_sanctuary_test", "label": "Sanctuary Test Design Gate", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every feature must pass the Sanctuary Test (does it make the user calmer and more in control, or add noise and pressure) plus invisible-when-unused and no-SaaS-tropes checks before implementation."}, {"id": "03_02_2026_implementation_plan_7_weekly_reset", "label": "Weekly Reset Guided Flow", "file_type": "concept", "source_file": "apps/frontend/docs/Initial Release/03-02-2026_implementation-plan-7.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 5-step guided weekly planning walkthrough (inbox review, unscheduled tasks, waiting, habit check-in, week ready) presented as a calm flow with natural-language stats, not a dashboard."}], "edges": [{"source": "03_02_2026_implementation_plan_7", "target": "03_02_2026_implementation_plan_7_waiting_state", "relation": "references", "confidence": 