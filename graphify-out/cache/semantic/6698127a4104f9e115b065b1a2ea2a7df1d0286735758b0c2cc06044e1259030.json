{"nodes": [{"id": "03_09_2026_audit_and_implementation_plan_14", "label": "Audit & Implementation Plan 14", "file_type": "document", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_audit_and_implementation_plan 14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Logic corrections (kanban order index, week-view UTC slice bug, habit restore cache, TimePickerInput infinite loop) plus manifesto-aligned spacing and empty-state refinements."}, {"id": "03_09_2026_audit_and_implementation_plan_14_timepicker_loop", "label": "TimePickerInput Infinite Loop Fix", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_audit_and_implementation_plan 14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A useEffect broadcasting onChange with an unmemoized parent callback causes Maximum update depth exceeded; the fix removes the effect and calls an explicit broadcastChange helper from increment/decrement handlers."}, {"id": "03_09_2026_audit_and_implementation_plan_14_weekview_utc_slice", "label": "Week-View UTC Slice Date Shift Bug", "file_type": "rationale", "source_file": "apps/frontend/docs/Initial Release/03-09-2026_audit_and_implementation_plan 14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging a drop date with the task hour via toISOString().slice(11) strips local time into UTC, shifting Tuesday-to-Thursday drops to Wednesday; parse local hours/minutes directly instead."}], "edges": [{"source": "03_09_2026_audit_and_implementation_plan_14", "target": "03_09_2026_audit_and_implementation_plan_14_timepicker_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/frontend/docs/Initial Release/03-09-2026_audit_and_implementation_plan 14.md", "source_location": nu