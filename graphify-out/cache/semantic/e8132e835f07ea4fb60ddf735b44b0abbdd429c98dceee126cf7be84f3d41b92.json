{"nodes": [{"id": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "label": "Cadence Desktop Improvement Plan", "file_type": "document", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "2026_03_24_tauri_improve_plan_privileged_client", "label": "Desktop as Privileged Client (ADR-002)", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop is held to a higher security bar than a browser tab: secrets must not live in plaintext, every native capability must justify itself, and webview compromise is assumed possible and contained."}, {"id": "2026_03_24_tauri_improve_plan_csp_hardening", "label": "Production CSP Hardening", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tauri csp is currently null; a strict production CSP (default-src self, scoped connect-src, frame-ancestors none) is one of the few containment layers left if the webview gets an XSS primitive in a privileged environment."}, {"id": "2026_03_24_tauri_improve_plan_secure_credential_storage", "label": "OS Keychain Credential Storage", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth tokens are stored in plaintext via the store plugin; secrets must move to the OS keychain so local compromise does not become account compromise, while the KV store keeps only non-sensitive preferences."}, {"id": "2026_03_24_tauri_improve_plan_oauth_csrf_hardening", "label": "OAuth/Deep-Link Anti-CSRF Replay Hardening", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the external-browser + local callback flow but add cryptographic state tokens, nonce/expiry, session binding, and rejection of stale/duplicate callbacks; replacing the flow is operationally riskier than hardening it."}, {"id": "2026_03_24_tauri_improve_plan_desktop_frame_model", "label": "Desktop Application Frame Model (ADR-003)", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elevate sync, offline, update, and command state into a stable application frame inspired by Discord's shell durability (not its aesthetic) so context switching feels anchored rather than like page navigation."}, {"id": "2026_03_24_tauri_improve_plan_local_first_db", "label": "Desktop Local-First SQLite + Sync Engine (ADR-004)", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current Query persistence + mutation WAL are transitional; desktop should adopt a local SQLite database, durable mutation journal, background sync, explicit sync state, and conflict surfacing for a true desktop trust story."}, {"id": "2026_03_24_tauri_improve_plan_layout_scale_model", "label": "Desktop Layout Scale Model", "file_type": "concept", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App-level view scale with Ctrl/Cmd +/-/0 and View-menu parity scales spacing and density tokens rather than relying on raw webview zoom that degrades crispness."}, {"id": "2026_03_24_tauri_improve_plan_shell_first_startup", "label": "Shell-First Startup Restoration", "file_type": "rationale", "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Render the shell and restore window/workspace state first, hydrate route data progressively, and never block first interaction on update checks, optimizing for long-lived desktop sessions."}], "edges": [{"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_privileged_client", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_csp_hardening", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_secure_credential_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_oauth_csrf_hardening", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_desktop_frame_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_local_first_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_layout_scale_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_2026_03_24_tauri_improve_plan", "target": "2026_03_24_tauri_improve_plan_shell_first_startup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_oauth_csrf_hardening", "target": "tauri_porting_plan_external_browser_oauth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_csp_hardening", "target": "tauri_porting_plan_capability_least_privilege", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}, {"source": "2026_03_24_tauri_improve_plan_local_first_db", "target": "agents_optimistic_ui_contract", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "desktop_security_hardening_workstream", "label": "Desktop Privileged-Client Security Hardening", "nodes": ["2026_03_24_tauri_improve_plan_privileged_client", "2026_03_24_tauri_improve_plan_csp_hardening", "2026_03_24_tauri_improve_plan_secure_credential_storage", "2026_03_24_tauri_improve_plan_oauth_csrf_hardening", "tauri_porting_plan_capability_least_privilege"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "apps/desktop/docs/2026-03-24_tauri_improve_plan.md"}]}