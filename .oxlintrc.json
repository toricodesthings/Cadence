                    {
                        "name": "fetch",
                        "message": "Use the RPC client (useApiClient); only transports call fetch."
                    },
                    {
                        "name": "matchMedia",
                        "message": "Use useShellMode()."
                    },
                    {
                        "name": "innerWidth",
                        "message": "Use useShellMode()."
                    },
                    {
                        "name": "localStorage",
                        "message": "UI reads storage through a hook or lib module."
