{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-frontend",
  "main": "worker.ts",
  "compatibility_date": "2026-02-27",

  // Static assets served from the React Router SPA build output.
  // "single-page-application" ensures client-side routing works by
  // serving index.html for any path that doesn't match a static file.
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },

  // ── Root environment (production) ─────────────────────────────────
  // Deployed via: wrangler deploy
  "vars": {
    "VITE_NEON_AUTH_URL": "https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth",
    "VITE_API_BASE_URL": "https://api.cadence.yourdomain.com" // TODO: Replace with production API URL
  },

  // ── Named environments ────────────────────────────────────────────
  "env": {
    // Dev environment — deployed via: wrangler deploy --env dev
    "dev": {
      "name": "cadence-frontend-dev",
      "vars": {
        "VITE_NEON_AUTH_URL": "https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth",
        "VITE_API_BASE_URL": "http://localhost:8787"
      }
    }
  }
}
