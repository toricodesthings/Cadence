{
  "name": "cadence",
  "version": "0.15.0",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@cadence/backend --filter=@cadence/frontend",
    "dev:frontend": "pnpm --filter @cadence/frontend dev",
    "dev:backend": "pnpm --filter @cadence/backend dev",
    "dev:desktop": "pnpm --filter @cadence/desktop dev",
    "dev:desktop:full": "turbo run dev --parallel --filter=@cadence/backend --filter=@cadence/desktop",
    "dev:landing": "pnpm --filter @cadence/landing dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @cadence/desktop build",
    "typecheck": "turbo run typecheck",
    "typecheck:desktop": "pnpm --filter @cadence/desktop typecheck",
    "lint": "turbo run lint",
    "cf-typegen": "turbo run cf-typegen",
    "db:generate": "pnpm --filter @cadence/backend db:generate",
    "db:migrate": "pnpm --filter @cadence/backend db:migrate",
    "db:studio": "pnpm --filter @cadence/backend db:studio",
    "deploy:frontend": "pnpm --filter @cadence/frontend deploy",
    "deploy:frontend:dev": "pnpm --filter @cadence/frontend deploy:dev",
    "deploy:backend": "pnpm --filter @cadence/backend deploy",
    "deploy:landing": "pnpm --filter @cadence/landing deploy",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.0",
    "oxlint": "^1.83.0",
    "release-it": "^21.0.2",
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.11",
      "esbuild": "^0.27.4",
      "effect": "3.21.0",
      "fastify": "^5.7.3",
      "hono": "^4.13.7",
      "lodash": "^4.17.23",
      "node-forge@<1.4.0": "1.4.0",
      "path-to-regexp@<0.1.13": "0.1.13",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "zod": "^4.6.2",
      "@daveyplate/better-auth-ui>@better-auth/api-key": "1.6.23"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "@better-auth/passkey",
        "@daveyplate/better-auth-tanstack",
        "@instantdb/react",
        "@tanstack/react-query",
        "@triplit/client",
        "@triplit/react"
      ],
      "allowedVersions": {
        "pg": ">=0",
        "react": ">=19",
        "better-auth>vitest": "5",
        "@better-auth/api-key>better-call": "2",
        "@triplit/logger>typescript": "7"
      }
    }
  }
}
