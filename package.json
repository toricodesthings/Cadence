{
  "name": "cadence",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@cadence/backend --filter=@cadence/frontend",
    "dev:frontend": "pnpm --filter @cadence/frontend dev",
    "dev:backend": "pnpm --filter @cadence/backend dev",
    "dev:mobile": "pnpm --filter @cadence/mobile dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "cf-typegen": "turbo run cf-typegen",
    "db:generate": "pnpm --filter @cadence/backend db:generate",
    "db:migrate": "pnpm --filter @cadence/backend db:migrate",
    "db:studio": "pnpm --filter @cadence/backend db:studio",
    "deploy:frontend": "pnpm --filter @cadence/frontend deploy",
    "deploy:frontend:dev": "pnpm --filter @cadence/frontend deploy:dev",
    "deploy:backend": "pnpm --filter @cadence/backend deploy"
  },
  "devDependencies": {
    "turbo": "^2.8.16"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@better-auth/passkey",
        "@daveyplate/better-auth-tanstack",
        "@instantdb/react",
        "@tanstack/react-query",
        "@triplit/client",
        "@triplit/react"
      ],
      "allowedVersions": {
        "pg": ">=0",
        "react": ">=19"
      }
    }
  }
}
