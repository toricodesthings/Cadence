{
  "name": "cadence",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@cadence/backend --filter=@cadence/frontend",
    "dev:frontend": "pnpm --filter @cadence/frontend dev",
    "dev:backend": "pnpm --filter @cadence/backend dev",
    "dev:desktop": "pnpm --filter @cadence/desktop dev",
    "dev:desktop:full": "turbo run dev --parallel --filter=@cadence/backend --filter=@cadence/desktop",
    "dev:landing": "pnpm --filter @cadence/landing dev",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @cadence/desktop build",
    "typecheck": "turbo run typecheck",
    "typecheck:desktop": "pnpm --filter @cadence/desktop typecheck",
    "lint": "node scripts/check-time.mjs && jscpd --silent && turbo run lint",
    "check:time": "node scripts/check-time.mjs",
    "check:dupes": "jscpd",
    "test": "turbo run test",
    "test:tz": "turbo run test:tz",
    "cf-typegen": "turbo run cf-typegen",
    "db:generate": "pnpm --filter @cadence/backend db:generate",
    "db:migrate": "pnpm --filter @cadence/backend db:migrate",
    "db:migrate:prod": "pnpm --filter @cadence/backend db:migrate:prod",
    "db:studio": "pnpm --filter @cadence/backend db:studio",
    "deploy:frontend": "pnpm --filter @cadence/frontend deploy",
    "deploy:frontend:dev": "pnpm --filter @cadence/frontend deploy:dev",
    "deploy:backend": "pnpm --filter @cadence/backend deploy",
    "deploy:landing": "pnpm --filter @cadence/landing run deploy",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "jscpd": "^4.3.0",
    "oxlint": "^1.85.0",
    "release-it": "^21.1.0",
    "turbo": "^2.11.4"
  }
}
