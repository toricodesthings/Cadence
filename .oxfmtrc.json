{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": false,
  "semi": true,
  "ignorePatterns": [
    "**/*.md",
    "pnpm-lock.yaml",
    "**/drizzle/**",
    "**/migrations/**",
    "**/*.gen.ts",
    "**/worker-configuration.d.ts",
    "**/routeTree.gen.ts",
    "apps/desktop/src-tauri/**",
    "videos/**",
    "developer-docs/**",
    "admin/**",
    "output/**",
    "graphify-out/**",
    ".agents/**"
  ]
}
