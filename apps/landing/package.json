{
  "name": "@cadence/landing",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "react-router build && for p in terms privacy changelog 404; do mv build/client/$p/index.html build/client/$p.html && rmdir build/client/$p; done && rm build/client/__spa-fallback.html",
    "dev": "react-router dev --port 8791",
    "preview": "pnpm build && npx wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@cadence/geometry": "workspace:*",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.136.1"
  }
}
