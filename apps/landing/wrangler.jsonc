{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-landing",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  "preview_urls": false

  // Root domain. Uncomment once you're ready to attach it (the dashboard lives on
  // dashboard.cadenceapp.cloud and the API on api.cadenceapp.cloud):
  // "workers_dev": false,
  // "routes": [
  //   { "pattern": "cadenceapp.cloud", "custom_domain": true },
  //   { "pattern": "www.cadenceapp.cloud", "custom_domain": true }
  // ]
}
