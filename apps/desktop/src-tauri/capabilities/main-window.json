{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allows the main Cadence window to access only the desktop capabilities it actually uses.",
  "windows": [
    "main",
    "quick-capture"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "deep-link:default",
    "global-shortcut:default",
    "keyring:allow-set-secret",
    "keyring:allow-get-secret",
    "keyring:allow-delete-secret",
    "notification:default",
    "oauth:allow-cancel",
    "oauth:allow-start",
    "opener:default",
    "process:default",
    "store:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:8787/*"
        },
        {
          "url": "http://127.0.0.1:8787/*"
        },
        {
          "url": "http://localhost:61827/*"
        },
        {
          "url": "http://127.0.0.1:61827/*"
        },
        {
          "url": "http://localhost:61828/*"
        },
        {
          "url": "http://127.0.0.1:61828/*"
        },
        {
          "url": "https://api.cadenceapp.cloud/*"
        },
        {
          "url": "https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech/*"
        },
        {
          "url": "https://ep-silent-grass-adfk8oeg.neonauth.c-2.us-east-1.aws.neon.tech/*"
        }
      ]
    }
  ]
}
