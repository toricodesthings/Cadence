{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cadence",
  "version": "0.1.0",
  "identifier": "com.cadence.desktop",
  "build": {
    "frontendDist": "../../frontend/build/client",
    "devUrl": "http://localhost:8790",
    "beforeDevCommand": "pnpm run dev:frontend",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @cadence/frontend build:desktop",
    "additionalWatchFolders": [
      "../../frontend",
      "../../../packages"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cadence",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787 http://127.0.0.1:8787 https://api.cadenceapp.cloud https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech https://ep-silent-grass-adfk8oeg.neonauth.c-2.us-east-1.aws.neon.tech http://localhost:61827 http://127.0.0.1:61827 http://localhost:61828 http://127.0.0.1:61828; worker-src 'self' blob:'",
      "capabilities": [
        "main-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cadence"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4MEQ1ODZDQjI4OTBEMUIKUldRYkRZbXliRmdOMkozZVMrTFRwbk1kQkF0dS9SVnBiY2FBU0VUczY4bFR6N1VWcWM5VDFNYmEK",
      "endpoints": [
        "https://github.com/toricodesthings/Cadence/releases/latest/download/latest.json"
      ]
    }
  }
}
