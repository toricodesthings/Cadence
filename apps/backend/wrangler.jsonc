{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-23",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.2,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "persist": true
    }
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "80ebbc92ada0464ca99496f0b3ac65ce"
    }
  ],

  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026031501",
      "simple": { "limit": 500, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_READ",
      "namespace_id": "2026031502",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_WRITE",
      "namespace_id": "2026031503",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_ADMIN",
      "namespace_id": "2026031504",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  "triggers": {
    "crons": ["0 6 * * *"]
  },
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.cadenceapp.cloud",
      "custom_domain": true
    }
  ],

  "env": {
    "dev": {
      "name": "cadence-backend-dev",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "c25e56a5b7894baa95da5e7f44216d4a"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "2026031511",
          "simple": { "limit": 500, "period": 60 }
        },
        {
          "name": "RATE_LIMITER_READ",
          "namespace_id": "2026031512",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "RATE_LIMITER_WRITE",
          "namespace_id": "2026031513",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "RATE_LIMITER_ADMIN",
          "namespace_id": "2026031514",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "triggers": {
        "crons": ["0 6 * * *"]
      }
    }
  }
}