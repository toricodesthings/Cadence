{
	"name": "@cadence/backend",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./types/*": "./src/types/*.ts"
	},
	"scripts": {
		"dev": "dotenvx run -f .dev.vars -- wrangler dev --env dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"check": "tsc --noEmit && vitest run",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:contracts": "vitest run tests/contracts",
		"test:security": "vitest run tests/security",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@cadence/nlp": "workspace:*",
		"@hono/zod-validator": "^0.7.6",
		"@neondatabase/auth": "0.2.0-beta.1",
		"@neondatabase/neon-js": "0.2.0-beta.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.23",
		"jose": "^6.2.3",
		"postgres": "^3.4.9",
		"rrule": "^2.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260603.1",
		"@dotenvx/dotenvx": "^1.71.0",
		"@types/node": "^25.9.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.9.3",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	}
}
