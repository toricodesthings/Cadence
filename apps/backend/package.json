{
	"name": "@cadence/backend",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./types/*": "./src/types/*.ts"
	},
	"scripts": {
		"dev": "dotenvx run -f .dev.vars -- wrangler dev --env dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"check": "tsc --noEmit && vitest run",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:security": "vitest run tests/security",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"db:generate": "drizzle-kit generate",
		"db:check": "drizzle-kit check",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@cadence/contracts": "workspace:*",
		"@cadence/domain": "workspace:*",
		"@cadence/nlp": "workspace:*",
		"@hono/zod-validator": "^0.9.1",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"@upstash/redis": "^1.39.0",
		"ai": "^7.0.116",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.9",
		"jose": "^6.2.12",
		"postgres": "^3.4.9",
		"rrule": "^2.8.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260926.1",
		"@dotenvx/dotenvx": "^2.30.0",
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-pgvector": "^0.0.9",
		"@types/node": "^25.9.8",
		"drizzle-kit": "^0.31.11",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2",
		"wrangler": "^4.141.0"
	}
}
