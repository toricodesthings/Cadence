{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-frontend",
  "main": "worker.ts",
  "compatibility_date": "2026-03-22",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*", "/auth/callback"]
  },

  "vars": {
    "NEON_AUTH_BASE_URL": "https://ep-silent-grass-adfk8oeg.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth"
  },
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dashboard.cadenceapp.cloud",
      "custom_domain": true
    }
  ],

  "env": {
    "dev": {
      "name": "cadence-frontend-dev",
      "vars": {
        "NEON_AUTH_BASE_URL": "https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth"
      }
    }
  }
}
