{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence-frontend",
  "main": "worker.ts",
  "compatibility_date": "2026-03-12",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "VITE_NEON_AUTH_URL": "https://ep-silent-grass-adfk8oeg.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth",
    "VITE_API_BASE_URL": "https://api.cadenceapp.cloud",
    "VITE_PUBLIC_APP_VERSION": "v0.2 Beta"
  },

  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "dashboard.cadenceapp.cloud",
      "custom_domain": true
    }
  ],

  // ── Named environments ────────────────────────────────────────────
  "env": {
    "dev": {
      "name": "cadence-frontend-dev",
      "vars": {
        "VITE_NEON_AUTH_URL": "https://ep-green-forest-aeushytt.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth",
        "VITE_API_BASE_URL": "http://localhost:8787",
        "VITE_PUBLIC_APP_VERSION": "v0.4 Beta"
      }
    }
  }
}
