{
  "name": "@cadence/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:desktop": "react-router build --mode desktop",
    "dev": "react-router dev --port 8788",
    "dev:desktop": "react-router dev --mode desktop --host 127.0.0.1 --port 8790",
    "dev:desktop-bridge": "react-router dev --host 127.0.0.1 --port 8789",
    "preview": "pnpm build && wrangler dev",
    "preview:dev": "pnpm build && wrangler dev --env dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dev": "pnpm build && wrangler deploy --env dev",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc",
    "cf-typegen": "wrangler types"
